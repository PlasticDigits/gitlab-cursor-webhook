# Copy to .env for local development. Never commit .env with real secrets.

# HTTP port (Render sets PORT automatically)
PORT=8080

# Cursor Automations webhook URL from the dashboard
CURSOR_WEBHOOK_URL=https://example.cursor.com/webhooks/your-webhook-id

# Cursor API key (crsr_… value only — do not include "Bearer" prefix)
CURSOR_TOKEN=crsr_REPLACE_WITH_YOUR_TOKEN

# GitLab project webhook "Secret token" (optional; when set, requires X-Gitlab-Token header)
# GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# Comma-separated GitLab usernames allowed to trigger Cursor (required at startup)
ALLOWED_USERS=plasticdigits,brouie

# Remember forwarded commit keys for this many seconds (optional, default 86400)
# DEDUP_TTL_SECS=86400

# Logging (optional)
# RUST_LOG=gitlab_cursor_webhook=info
