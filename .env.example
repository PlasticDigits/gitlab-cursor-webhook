# Copy to .env for local development. Never commit .env with real secrets.

# HTTP port (Render sets PORT automatically)
PORT=8080

# GitLab path_with_namespace → Cursor webhook URL + API key.
# Comma-separated path-or-id=url|crsr_token pairs. Token is the crsr_… value only (no "Bearer").
# Find paths under Settings → General in GitLab.

# MR security review automation (required).
PROJECT_WEBHOOKS_SECURITY=plasticdigits/yieldomega=https://example.cursor.com/webhooks/yieldomega-security|crsr_YIELDOMEGA_SECURITY,plasticdigits/cl8y-dex-terraclassic=https://example.cursor.com/webhooks/cl8y-security|crsr_CL8Y_SECURITY

# Issue verify automation — label agent:verify (optional; omit if unused).
PROJECT_WEBHOOKS_VERIFY=plasticdigits/yieldomega=https://example.cursor.com/webhooks/yieldomega-verify|crsr_YIELDOMEGA_VERIFY,plasticdigits/cl8y-dex-terraclassic=https://example.cursor.com/webhooks/cl8y-verify|crsr_CL8Y_VERIFY

# Issue implement automation — label agent:implement (optional; omit if unused).
PROJECT_WEBHOOKS_IMPLEMENT=plasticdigits/yieldomega=https://example.cursor.com/webhooks/yieldomega-implement|crsr_YIELDOMEGA_IMPLEMENT,plasticdigits/cl8y-dex-terraclassic=https://example.cursor.com/webhooks/cl8y-implement|crsr_CL8Y_IMPLEMENT

# GitLab project webhook "Secret token" (optional; when set, requires X-Gitlab-Token header)
# GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# Comma-separated GitLab usernames allowed to trigger Cursor (required at startup)
ALLOWED_USERS=plasticdigits,brouie

# Remember forwarded MR commit keys for this many seconds (optional, default 86400)
# DEDUP_TTL_SECS=86400

# Remember forwarded issue keys for this many seconds (optional, default 900 = 15 min).
# Verify and implement share one key per issue.
# ISSUE_DEDUP_TTL_SECS=900

# Logging (optional)
# RUST_LOG=gitlab_cursor_webhook=info
