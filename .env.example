# gchcontroller — copy to .env for local development. Never commit .env.

PORT=8080
# Bind loopback only so only a local reverse proxy (e.g. Caddy) can reach the app.
LISTEN_ADDR=127.0.0.1:8080
RUST_LOG=gchcontroller=info

# GitLab webhook security (allowed users; per-project signing tokens live in SQLite via gchconfig)
ALLOWED_USERS=plasticdigits,brouie

# SQLite configuration database
GCH_DB_PATH=/var/lib/gch/gch.db

# Hetzner Cloud
HCLOUD_TOKEN=
GCH_FIREWALL_ID=
# SSH keys injected into new agent VMs (comma-separated). Each entry may be a numeric
# Hetzner key id, key name (e.g. admin-ceramic), or fingerprint. Without this, Hetzner
# creates VMs with a root password instead of your SSH key.
GCH_SSH_KEY_IDS=admin-ceramic
# Optional single-key shorthand (merged with GCH_SSH_KEY_IDS if set)
# GCH_SSH_KEY_NAME=admin-ceramic
GCH_CONTROLLER_URL=https://gch.example.com

# Secrets injected into agent VM cloud-init
CURSOR_API_KEY=
GITLAB_TOKEN=

# Admin API for gchconfig jobs (Bearer token; set same value where you run gchconfig)
GCH_ADMIN_TOKEN=

# Paths (defaults assume running from repo root on controller host)
GCH_JOBS_DIR=/var/lib/gch/jobs
GCH_TERRAFORM_MODULE=terraform/modules/agent-vm
GCH_CLOUD_INIT_TEMPLATE=templates/cloud_init.yaml.tpl

# Set false to register jobs without calling terraform (tests/dev)
GCH_PROVISION_ENABLED=true

# Provision queue — defer when near Hetzner server cap; poll every 30s, longer backoff on placement failures
GCH_HETZNER_SERVER_LIMIT=15
GCH_HETZNER_SERVER_QUEUE_THRESHOLD=14
GCH_PROVISION_QUEUE_POLL_SECS=30
GCH_PROVISION_QUEUE_RETRY_SECS=1800

# Dedup TTLs (seconds)
DEDUP_TTL_SECS=86400
ISSUE_DEDUP_TTL_SECS=900
